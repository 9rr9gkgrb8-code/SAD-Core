# Optional local Ollama-compatible study model. Never put secrets in this file.
SAD_LOCAL_MODEL=your-local-model-name
SAD_LOCAL_MODEL_URL=http://127.0.0.1:11434

# Required only for genuine isolated Forge verification. The image must already
# exist locally and must use its exact sha256 digest.
SAD_SANDBOX_IMAGE=sad-sandbox@sha256:replace_with_64_lowercase_hex_characters

# Optional paired mobile gateway. Use one explicit private/overlay IPv4 address,
# never 0.0.0.0 or a public address. TLS certificate/key files stay local.
SAD_MOBILE_HOST=192.168.1.20
SAD_MOBILE_PORT=8766
SAD_MOBILE_CERT=C:\path\to\trusted-mobile-cert.pem
SAD_MOBILE_KEY=C:\path\to\trusted-mobile-key.pem
